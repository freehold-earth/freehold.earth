---
// The "breakout plot" mark: your plot (chalk) breaks out of the corner of the
// frame. Held outright, outside anyone else's box. See DESIGN.md.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 22 22" aria-hidden="true" focusable="false">
    <rect width="22" height="22" fill="#1f1a16"></rect>
    <rect x="4" y="4" width="14" height="14" fill="#d4734a"></rect>
    <rect x="11" y="11" width="11" height="11" fill="#f6efe4"></rect>
  </svg>
  <span class="word">Freehold</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .word {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.875rem;
  }
</style>
