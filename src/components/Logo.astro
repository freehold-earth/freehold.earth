---
// The "plots" mark: four plots of land, one held by you (chalk).
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 22 22" aria-hidden="true" focusable="false">
    <rect width="22" height="22" fill="#1f1a16"></rect>
    <rect x="4" y="4" width="6" height="6" fill="#d4734a"></rect>
    <rect x="12" y="4" width="6" height="6" fill="#d4734a"></rect>
    <rect x="4" y="12" width="6" height="6" fill="#d4734a"></rect>
    <rect x="12" y="12" width="6" height="6" fill="#f6efe4"></rect>
  </svg>
  <span class="word">Freehold</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .word {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.875rem;
  }
</style>
