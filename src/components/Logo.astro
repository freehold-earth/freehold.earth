---
// The breakout plot mark with the FREEHOLD wordmark. Shapes and colours come
// from src/data/brand.ts. See DESIGN.md for what the mark means.
import { markShapes } from '../data/brand';

interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<span class="logo">
  <svg
    width={size}
    height={size}
    viewBox="0 0 22 22"
    aria-hidden="true"
    focusable="false"
    set:html={markShapes()}
  />
  <span class="word">Freehold</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .word {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.875rem;
  }
</style>
