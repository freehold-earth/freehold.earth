---
// Illustration of the v0.1 demo flow. Source: demo/README.md "Request Flow":
// the business asks for age >= 21, the user approves, the agent reads the birth
// date from the encrypted context store, the ZKP service returns a proof, and
// the business sees "Verified (ageOver: 21)". Works as a static list without JS.
const received = [
  ['Over 21?', 'Yes, proven', true],
  ['Date of birth', 'not shared', false],
  ['Name', 'not shared', false],
  ['Address', 'not shared', false],
] as const;
---

<figure class="walk" aria-labelledby="walk-cap">
  <ol class="steps">
    <li data-step="1">
      <p class="mono who">The shop</p>
      <p class="say">"Are you over 21?"</p>
      <p>The shop sends a request for one fact, not your ID.</p>
    </li>
    <li data-step="2">
      <p class="mono who">Your device</p>
      <p class="say">You approve the request.</p>
      <p>
        Your agent reads your date of birth from your encrypted store. It never leaves your device.
      </p>
    </li>
    <li data-step="3">
      <p class="mono who">Your device</p>
      <p class="say">A proof is made.</p>
      <p>A zero-knowledge proof says "over 21" is true, without saying anything else.</p>
    </li>
    <li data-step="4">
      <p class="mono who">What the shop receives</p>
      <dl class="panel">
        {received.map(([k, v, ok]) => (
          <div class="row">
            <dt>{k}</dt>
            <dd class:list={[ok ? 'yes' : 'no']}>
              <span aria-hidden="true">{ok ? '✓ ' : '✕ '}</span>
              {v}
            </dd>
          </div>
        ))}
      </dl>
      <p class="later">
        In the full design, your rules can also require the shop to keep nothing and stop it
        recognising you next time. That part is planned.
      </p>
    </li>
  </ol>
  <figcaption id="walk-cap" class="mono">
    Illustration of the v0.1 demo flow
  </figcaption>
</figure>

<script>
  // Enhances the static list into a one-step-at-a-time walkthrough. All steps
  // share one grid cell, so the box is always as tall as the tallest step and
  // the controls never move.
  const fig = document.querySelector<HTMLElement>('.walk');
  if (fig) {
    const steps = [...fig.querySelectorAll<HTMLElement>('[data-step]')];
    let current = 0;

    const button = (text: string) =>
      Object.assign(document.createElement('button'), { type: 'button', textContent: text });
    const prev = button('Back');
    const next = button('Next');
    const restart = button('Start again');
    const counter = document.createElement('p');
    counter.className = 'mono counter';
    counter.textContent = `Step 1 of ${steps.length}`;
    const forward = document.createElement('div');
    forward.className = 'forward';
    forward.append(next, restart);
    const controls = document.createElement('div');
    controls.className = 'controls';
    controls.append(prev, counter, forward);
    fig.append(controls);

    const show = (i: number) => {
      current = i;
      steps.forEach((s, n) => {
        s.classList.toggle('is-current', n === i);
        s.inert = n !== i;
      });
      counter.textContent = `Step ${i + 1} of ${steps.length}`;
      prev.classList.toggle('is-off', i === 0);
      next.hidden = i === steps.length - 1;
      restart.hidden = i !== steps.length - 1;
    };

    // Keep keyboard focus on a usable control when the pressed one goes away.
    prev.addEventListener('click', () => {
      show(Math.max(0, current - 1));
      if (current === 0) next.focus();
    });
    next.addEventListener('click', () => {
      show(Math.min(steps.length - 1, current + 1));
      if (next.hidden) restart.focus();
    });
    restart.addEventListener('click', () => {
      show(0);
      next.focus();
    });

    fig.dataset.enhanced = '';
    show(0);
    // Only announce changes the reader causes, not the initial state.
    counter.setAttribute('aria-live', 'polite');
  }
</script>

<style>
  .walk {
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--chalk) 25%, transparent);
    background: var(--soil);
    padding: var(--space-5);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .steps li {
    transition: opacity 0.2s ease;
  }
  .who {
    color: var(--sun-light);
    margin-bottom: var(--space-2);
  }
  .say {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }
  .panel {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--chalk) 25%, transparent);
  }
  dd {
    margin: 0;
    text-align: right;
  }
  .yes {
    color: var(--positive);
  }
  .no {
    color: var(--negative);
  }
  .later {
    margin-top: var(--space-4);
    font-size: 0.9rem;
    opacity: 0.85;
  }
  figcaption {
    margin-top: var(--space-5);
    opacity: 0.8;
  }
  .walk :global(.controls) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .walk :global(.controls button) {
    min-width: 8.5rem;
    padding: 0.65rem 1rem;
    border: 2px solid var(--chalk);
    background: transparent;
    color: var(--chalk);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .walk :global(.controls button:hover) {
    background: color-mix(in srgb, var(--chalk) 10%, transparent);
  }
  .walk :global(.controls button.is-off) {
    visibility: hidden;
  }
  .walk :global(.controls button[hidden]) {
    display: none;
  }
  .walk :global(.counter) {
    margin: 0;
    text-align: center;
    opacity: 0.85;
  }
  .walk[data-enhanced] .steps {
    grid-template-areas: 'step';
  }
  .walk[data-enhanced] .steps li {
    grid-area: step;
  }
  .walk[data-enhanced] .steps li:not(.is-current) {
    visibility: hidden;
  }
  /* Narrow screens: counter on its own row so the two buttons fit. */
  @media (max-width: 26rem) {
    .walk :global(.controls) {
      grid-template-columns: auto auto;
      justify-content: space-between;
      grid-template-areas: 'counter counter' 'back forward';
    }
    .walk :global(.counter) {
      grid-area: counter;
    }
    .walk :global(.controls > button) {
      grid-area: back;
    }
    .walk :global(.forward) {
      grid-area: forward;
    }
    .walk :global(.controls button) {
      min-width: 7rem;
      padding-inline: 0.6rem;
    }
  }
</style>
