---
// Illustration of the v0.1 demo flow. Source: demo/README.md "Request Flow":
// the business asks for age >= 21, the user approves, the agent reads the birth
// date from the encrypted context store, the ZKP service returns a proof, and
// the business sees "Verified (ageOver: 21)". Works as a static list without JS.
const received = [
  ['Over 21?', 'Yes, proven', true],
  ['Date of birth', 'not shared', false],
  ['Name', 'not shared', false],
  ['Address', 'not shared', false],
] as const;
---

<figure class="walk" aria-labelledby="walk-cap">
  <ol class="steps">
    <li data-step="1">
      <p class="mono who">The shop</p>
      <p class="say">"Are you over 21?"</p>
      <p>The shop sends a request for one fact, not your ID.</p>
    </li>
    <li data-step="2">
      <p class="mono who">Your device</p>
      <p class="say">You approve the request.</p>
      <p>
        Your agent reads your date of birth from your encrypted store. It never leaves your device.
      </p>
    </li>
    <li data-step="3">
      <p class="mono who">Your device</p>
      <p class="say">A proof is made.</p>
      <p>A zero-knowledge proof says "over 21" is true, without saying anything else.</p>
    </li>
    <li data-step="4">
      <p class="mono who">What the shop receives</p>
      <dl class="panel">
        {received.map(([k, v, ok]) => (
          <div class="row">
            <dt>{k}</dt>
            <dd class:list={[ok ? 'yes' : 'no']}>
              <span aria-hidden="true">{ok ? '✓ ' : '✕ '}</span>
              {v}
            </dd>
          </div>
        ))}
      </dl>
      <p class="later">
        In the full design, your rules can also require the shop to keep nothing and stop it
        recognising you next time. That part is planned.
      </p>
    </li>
  </ol>
  <figcaption id="walk-cap" class="mono">
    Illustration of the v0.1 demo flow
  </figcaption>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('.walk');
  if (fig) {
    const steps = [...fig.querySelectorAll<HTMLElement>('[data-step]')];
    let current = 0;

    const controls = document.createElement('div');
    controls.className = 'controls';
    const counter = document.createElement('p');
    counter.className = 'mono counter';
    counter.setAttribute('aria-live', 'polite');
    const prev = Object.assign(document.createElement('button'), {
      type: 'button',
      textContent: 'Back',
    });
    const next = Object.assign(document.createElement('button'), {
      type: 'button',
      textContent: 'Next',
    });
    const restart = Object.assign(document.createElement('button'), {
      type: 'button',
      textContent: 'Start again',
    });
    controls.append(prev, next, restart, counter);
    fig.append(controls);

    const show = (i: number) => {
      current = i;
      steps.forEach((s, n) => (s.hidden = n !== i));
      counter.textContent = `Step ${i + 1} of ${steps.length}`;
      prev.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      restart.hidden = i !== steps.length - 1;
    };

    // Keep keyboard focus on a visible control when the pressed one hides itself.
    prev.addEventListener('click', () => {
      show(Math.max(0, current - 1));
      if (prev.hidden) next.focus();
    });
    next.addEventListener('click', () => {
      show(Math.min(steps.length - 1, current + 1));
      if (next.hidden) restart.focus();
    });
    restart.addEventListener('click', () => {
      show(0);
      next.focus();
    });

    fig.dataset.enhanced = '';
    show(0);
  }
</script>

<style>
  .walk {
    margin: 0;
    border: 1px solid rgb(246 239 228 / 25%);
    background: #2a241f;
    padding: var(--space-5);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .steps li {
    transition: opacity 0.2s ease;
  }
  .who {
    color: var(--sun-light);
    margin-bottom: var(--space-2);
  }
  .say {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }
  .panel {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px dashed rgb(246 239 228 / 25%);
  }
  dd {
    margin: 0;
    text-align: right;
  }
  .yes {
    color: #b9dfa8;
  }
  .no {
    color: #f0a483;
  }
  .later {
    margin-top: var(--space-4);
    font-size: 0.9rem;
    opacity: 0.85;
  }
  figcaption {
    margin-top: var(--space-5);
    opacity: 0.8;
  }
  .walk :global(.controls) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .walk :global(.controls button) {
    padding: 0.65rem 1rem;
    border: 2px solid var(--chalk);
    background: transparent;
    color: var(--chalk);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .walk :global(.controls button:hover) {
    background: rgb(246 239 228 / 10%);
  }
  .walk :global(.controls button[hidden]) {
    display: none;
  }
  .walk :global(.counter) {
    margin: 0 0 0 auto;
    opacity: 0.85;
  }
  .walk[data-enhanced] .steps li[hidden] {
    display: none;
  }
</style>
