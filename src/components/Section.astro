---
import type { SectionTone } from './types';

interface Props {
  tone: SectionTone;
  grid?: boolean;
  id?: string;
  labelledby?: string;
}
const { tone, grid = false, id, labelledby } = Astro.props;
---

<section class:list={['section', tone, { grid }]} id={id} aria-labelledby={labelledby}>
  <div class="wrap">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    scroll-margin-top: var(--space-4);
  }
  .grid {
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 44px 44px;
  }
  .clay {
    background-color: var(--clay);
    color: var(--ink);
  }
  .clay-soft {
    background-color: var(--clay-soft);
    color: var(--ink);
  }
  .chalk {
    background-color: var(--chalk);
    color: var(--ink);
  }
  .sun {
    background-color: var(--sun);
    color: var(--ink);
  }
  .ink {
    background-color: var(--ink);
    color: var(--chalk);
  }
  .soil {
    background-color: var(--soil);
    color: var(--chalk);
  }
  .moss {
    background-color: var(--moss);
    color: var(--chalk);
  }
</style>
