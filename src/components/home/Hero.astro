---
import PageHero from '../PageHero.astro';
import Button from '../Button.astro';
---

<PageHero
  kicker="Open source · Local-first · Community-run"
  title="Your data. Your rules. Your community."
>
  <p>
    Freehold keeps your data on your own devices, lets your own AI work on it, and enforces your
    rules with maths rather than promises. Run it yourself, or with your local library, co-op or
    neighbourhood.
  </p>
  <Fragment slot="ctas">
    <Button href="#see-it-work">See it work</Button>
    <Button href="/build/" variant="secondary">
      I'm a builder
    </Button>
  </Fragment>
</PageHero>
