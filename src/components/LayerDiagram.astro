---
// The four layers stacked with your data at the bottom, and identity as a
// spine pinned through every layer (option B, chosen by the owner). Layers
// match the freehold README directory table. Plain HTML so text stays full
// size on phones.
const layers = [
  { n: '4', name: 'Proofs', note: 'Zero-knowledge, on Midnight', tone: 'soil' },
  { n: '3', name: 'Policy enforcement', note: 'Your rules, enforced on Cardano', tone: 'clay' },
  { n: '2', name: 'Personal agent', note: 'Your AI, on your hardware', tone: 'sun' },
  { n: '1', name: 'Context store', note: 'Your encrypted data', tone: 'sage' },
];
---

<figure class="diagram" aria-labelledby="layers-caption">
  <div class="identity">
    <strong>Identity</strong>
    <span class="mono did">did:key</span>
    <span class="note">One key, through every layer</span>
  </div>
  <div class="stack-wrap">
    <ol class="stack">
      {layers.map((l) => (
        <li class={l.tone}>
          <span class="pin" aria-hidden="true" />
          <span class="mono num">Layer {l.n}</span>
          <strong>{l.name}</strong>
          <span class="note">{l.note}</span>
        </li>
      ))}
    </ol>
    <span class="spine" aria-hidden="true"></span>
  </div>
  <figcaption id="layers-caption" class="visually-hidden">
    The Freehold layers, from the top: 4 proofs, 3 policy enforcement, 2 personal agent, 1 context
    store with your data at the foundation. Identity runs through all four.
  </figcaption>
</figure>

<style>
  .diagram {
    --spine-x: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    max-width: 46rem;
    margin: var(--space-5) 0 0;
  }
  .identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }
  .identity strong {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .did {
    /* DID method names are lowercase identifiers. */
    text-transform: none;
  }
  .stack-wrap {
    position: relative;
    padding-block: var(--space-4);
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 2px solid var(--ink);
  }
  .stack li {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'num num' 'name note';
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) var(--space-5) var(--space-4) calc(var(--spine-x) + 1.75rem);
  }
  .stack li + li {
    border-top: 2px solid var(--ink);
  }
  .soil {
    background: var(--soil);
    color: var(--chalk);
  }
  .soil .num {
    color: var(--sun-light);
  }
  .clay {
    background: var(--clay);
  }
  .sun {
    background: var(--sun);
  }
  .sage {
    background: var(--sage);
  }
  .num {
    grid-area: num;
    font-size: 0.72rem;
  }
  .stack strong {
    grid-area: name;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .stack .note {
    grid-area: note;
    font-size: 0.9rem;
    text-align: right;
  }
  /* The identity spine: one line through the whole stack, pinned at each layer. */
  .spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--spine-x) - 2px);
    width: 4px;
    background: var(--ink);
  }
  .pin {
    position: absolute;
    left: calc(var(--spine-x) - 0.6rem);
    top: 50%;
    width: 1.2rem;
    height: 1.2rem;
    transform: translateY(-50%);
    background: var(--chalk);
    border: 4px solid var(--ink);
    z-index: 1;
  }
  @media (max-width: 34rem) {
    .stack li {
      grid-template-columns: 1fr;
      grid-template-areas: 'num' 'name' 'note';
      padding-right: var(--space-4);
    }
    .stack .note {
      text-align: left;
    }
  }
  @media (min-width: 52rem) {
    .diagram {
      grid-template-columns: 9rem 1fr;
      align-items: center;
    }
    .identity {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
