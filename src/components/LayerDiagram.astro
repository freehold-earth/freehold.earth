---
// Layers as described in the freehold README directory table (Layer 1 to 4),
// with identity alongside. Plain HTML so text stays full size on phones.
const layers = [
  { n: '1', name: 'Context store', note: 'Your encrypted data' },
  { n: '2', name: 'Personal agent', note: 'Your AI, on your hardware' },
  { n: '3', name: 'Policy enforcement', note: 'S-PAL rules on Cardano' },
  { n: '4', name: 'Proofs', note: 'Zero-knowledge, on Midnight' },
];
---

<figure class="diagram" aria-labelledby="layers-caption">
  <ol class="stack">
    {layers.map((l) => (
      <li>
        <span class="mono num">Layer {l.n}</span>
        <strong>{l.name}</strong>
        <span class="note">{l.note}</span>
      </li>
    ))}
  </ol>
  <div class="identity">
    <strong>Identity</strong>
    <span class="mono num">did:key</span>
    <span class="note">Alongside every layer</span>
  </div>
  <figcaption id="layers-caption" class="visually-hidden">
    The Freehold layers: four stacked layers, with identity alongside all four.
  </figcaption>
</figure>

<style>
  .diagram {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    max-width: 40rem;
    margin: var(--space-5) 0 0;
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .stack li {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'num num' 'name note';
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--ink);
    background: var(--clay);
  }
  .stack li:nth-child(even) {
    background: var(--clay-soft);
  }
  .num {
    grid-area: num;
    font-size: 0.72rem;
  }
  strong {
    grid-area: name;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .note {
    grid-area: note;
    font-size: 0.9rem;
    text-align: right;
  }
  .identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--ink);
    background: var(--chalk);
  }
  .identity .note {
    text-align: left;
  }
  .identity .num {
    /* DID method names are lowercase identifiers. */
    text-transform: none;
  }
  @media (max-width: 30rem) {
    .stack li {
      grid-template-columns: 1fr;
      grid-template-areas: 'num' 'name' 'note';
    }
    .note {
      text-align: left;
    }
  }
  @media (min-width: 48rem) {
    .diagram {
      grid-template-columns: 1fr 9rem;
    }
    .identity {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }
    .identity .note {
      text-align: center;
    }
  }
</style>
