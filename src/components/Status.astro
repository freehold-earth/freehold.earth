---
import { getStatus, STATE_LABEL } from '../data/status';

interface Props {
  id: string;
  showLabel?: boolean;
}
const { id, showLabel = false } = Astro.props;
const item = getStatus(id);
---

<span class="status-wrap">
  {showLabel && <span class="item">{item.label}</span>}
  <span class="mono tag" data-state={item.state}>
    {STATE_LABEL[item.state]}
  </span>
</span>

<style>
  .status-wrap {
    display: inline-grid;
    grid-auto-flow: column;
    /* The tag follows its words; long labels wrap beside it. */
    grid-template-columns: minmax(0, max-content);
    justify-content: start;
    align-items: start;
    gap: var(--space-3);
  }
  .item {
    padding-top: 0.1rem;
  }
  .tag {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-size: 0.7rem;
    border: 1.5px solid currentColor;
    white-space: nowrap;
  }
  .tag[data-state='preview'] {
    background: var(--positive);
    border-color: var(--positive);
    color: var(--ink);
  }
  .tag[data-state='in-development'] {
    background: var(--sun);
    border-color: var(--sun);
    color: var(--ink);
  }
</style>
