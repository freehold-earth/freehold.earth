---
import { getStatus, STATE_LABEL } from '../data/status';

interface Props {
  id: string;
  showLabel?: boolean;
}
const { id, showLabel = false } = Astro.props;
const item = getStatus(id);
---

<span class="status-wrap">
  {showLabel && <span class="item">{item.label}</span>}
  <span class="mono tag" data-state={item.state}>
    {STATE_LABEL[item.state]}
  </span>
</span>

<style>
  .status-wrap {
    display: inline-grid;
    grid-auto-flow: column;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--space-3);
    width: 100%;
  }
  .status-wrap:not(:has(.item)) {
    width: auto;
  }
  .item {
    padding-top: 0.1rem;
  }
  .tag {
    justify-self: end;
  }
  .tag {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-size: 0.7rem;
    border: 1.5px solid currentColor;
    white-space: nowrap;
  }
  .tag[data-state='preview'] {
    background: #b9dfa8;
    border-color: #b9dfa8;
    color: var(--ink);
  }
  .tag[data-state='in-development'] {
    background: var(--sun);
    border-color: var(--sun);
    color: var(--ink);
  }
</style>
