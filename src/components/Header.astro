---
import Logo from './Logo.astro';
import { NAV } from '../data/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home" aria-label="Freehold home">
      <Logo />
    </a>
    <nav aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li>
            <a class="mono" href={item.href}>
              {item.label}
              {item.href.startsWith('http') && <span aria-hidden="true"> ↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--clay);
    color: var(--ink);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-5);
  }
  .home {
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
</style>
