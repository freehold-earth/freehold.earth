---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---

<Base
  title="Page not found"
  description="This page does not exist. Head back to the Freehold homepage."
  noindex
>
  <PageHero kicker="404" title="This plot is empty.">
    <p>There is nothing here. It may have moved, or never existed.</p>
    <Fragment slot="ctas">
      <Button href="/">Back to the homepage</Button>
      <Button href="/build/" variant="secondary">
        Build with Freehold
      </Button>
    </Fragment>
  </PageHero>
</Base>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
