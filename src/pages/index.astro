---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Kicker from '../components/Kicker.astro';
---

<Base
  title="Freehold"
  description="Your data, your rules, your community. Freehold is open source, local-first infrastructure for data sovereignty."
>
  <Section tone="clay" grid>
    <Kicker>Freehold, not leasehold</Kicker>
    <h1>Your data. Your rules. Your community.</h1>
    <Button href="/build/">I'm a builder</Button>
  </Section>
</Base>
