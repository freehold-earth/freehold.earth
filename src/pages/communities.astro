---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Kicker from '../components/Kicker.astro';
import Button from '../components/Button.astro';
import Status from '../components/Status.astro';
import PageHero from '../components/PageHero.astro';
import Datacentre from '../components/home/Datacentre.astro';
import CallToAction from '../components/CallToAction.astro';
import { REPO_URL, TALK_URL } from '../data/site';

// Sources: docs/decisions/004-infrastructure-philosophy.md (tiers, principles),
// docs/concepts/manifesto.md (community cloud, economics table),
// docs/concepts/executive-brief.md (costs). Figures are the docs' own estimates.
// The "what we're planning" list is the owner's stated intent (2026-10-17).
const hosts = [
  [
    'Local libraries',
    "Already places for shared resources, shared knowledge and public service. Looking after the community's data fits right in.",
  ],
  ['Co-ops', 'Owned by their members already. A node is one more thing members share.'],
  ['Clubs, faith groups and associations', 'Existing trust, existing ways of making decisions.'],
  ['Families and friends', 'One small server, shared between people who already trust each other.'],
];

const tiers = [
  [
    'Your devices',
    'Your phone, laptop or home server.',
    'Everything stays with you, and you look after it.',
  ],
  [
    'Family and friends',
    "A small server at a relative's or friend's house.",
    'Run by people you trust, on terms you agree between you.',
  ],
  [
    'Your community',
    'Your local library, co-op or community centre.',
    'Shared costs, shared skills, local decisions.',
  ],
  [
    'A federation',
    'Several communities, or a council service, pooling resources.',
    'Lower costs for everyone, and each community keeps its say.',
  ],
  [
    'Commercial cloud',
    'A mainstream cloud provider.',
    'There if you need it today. Freehold meets you wherever you are on the way to running things yourselves.',
  ],
];

const costs = [
  ['Your own devices', 'Free'],
  ['Family node', '~$20 a month, shared'],
  ['Community node', '~$10 per member a month'],
  ['Federation', '~$5 per member a month'],
];

const planned = [
  'Step-by-step guides for setting up and running a node',
  'A reference setup you can copy',
  'Do-it-yourself and one-click ways to deploy',
  'Guides for organisations choosing hardware and services',
];
---

<Base
  title="Communities"
  tone="sun"
  description="A Freehold community node is a datacentre your local library, co-op or village hall owns, runs and decides about. Shared costs, shared skills, local benefits."
>
  <PageHero kicker="Communities" title="The datacentre is yours." tone="sun">
    <p>
      Run Freehold on your own devices, or share a node with people you actually live near: your
      local library, a co-op, a club or your family.
    </p>
    <Fragment slot="ctas">
      <Button href={TALK_URL}>Talk to us about hosting</Button>
      <Button href="#costs" variant="secondary">
        What it costs
      </Button>
    </Fragment>
  </PageHero>

  <Section tone="chalk" labelledby="why-heading">
    <Kicker>Why share?</Kicker>
    <h2 id="why-heading">Better together, if you want it.</h2>
    <p>
      You can run Freehold entirely on your own devices, and that is a first-class way to use it. A
      community node is for when you would rather share: share the hardware and the costs, share the
      skills, and look after it with people you know.
    </p>
    <p>
      Your rules still decide what leaves your devices, and the node is run by people you know,
      under rules your community agrees.
    </p>
    <ul class="hosts">
      {hosts.map(([who, why]) => (
        <li>
          <h3>{who}</h3>
          <p>{why}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Datacentre title="It matters who owns the datacentre." />

  <Section tone="chalk" grid labelledby="tiers-heading">
    <Kicker>From your phone to your town</Kicker>
    <h2 id="tiers-heading">Run it where it makes sense.</h2>
    <p>
      Freehold is designed to work at every scale. Start wherever suits you and move along when you
      are ready. Your rules will be able to say which of these may handle which parts of your data.
    </p>
    <p class="locality">
      <Status id="compute-locality" showLabel />
    </p>
    <ol class="tiers">
      {tiers.map(([name, what, trade], i) => (
        <li>
          <span class="mono num">0{i}</span>
          <div>
            <h3>{name}</h3>
            <p>{what}</p>
            <p class="trade">{trade}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section tone="ink" id="costs" labelledby="cost-heading">
    <Kicker>What it costs</Kicker>
    <h2 id="cost-heading">Shared local costs, shared local benefits.</h2>
    <p>
      We have estimated running costs for a healthy, active community, from the project's own
      planning documents. The money pays for hardware, power and a local operator, not a distant
      company's profits. Real costs will depend on hardware, power and local wages.
    </p>
    <dl class="costs">
      {costs.map(([what, cost]) => (
        <div data-cost>
          <dt class="mono">{what}</dt>
          <dd>{cost}</dd>
        </div>
      ))}
    </dl>
    <p class="small">
      The more members share a node, or the more communities pool together, the less it costs each
      person.
    </p>
  </Section>

  <Section tone="chalk" labelledby="prec-heading">
    <Kicker>It's already happening</Kicker>
    <h2 id="prec-heading">Communities already run their own infrastructure.</h2>
    <ul class="prec">
      <li>
        <h3>
          <a href="https://guifi.net/en">Guifi.net</a>
        </h3>
        <p>A community-built network in Catalonia with tens of thousands of nodes.</p>
      </li>
      <li>
        <h3>El Servidor del Barri</h3>
        <p>A neighbourhood server in Barcelona running email, files, passwords and calendars.</p>
      </li>
      <li>
        <h3>
          <a href="https://www.bbc.co.uk/news/articles/c0rpy7envr5o">Community Box</a>
        </h3>
        <p>Local cloud services for rural communities in the UK.</p>
      </li>
    </ul>
    <p class="small">These projects inspire Freehold. They are not affiliated with it.</p>
  </Section>

  <Section tone="soil" labelledby="status-heading">
    <Kicker>How we're doing</Kicker>
    <h2 id="status-heading">Be one of the first.</h2>
    <p>
      There is no ready-made community node kit yet. Today a developer can run every part of
      Freehold on their own machine. Making it easy for a local library or co-op to run is the next
      big step, and we want to build it with the first communities, not for them.
    </p>
    <h3 class="sub">What we're planning</h3>
    <ul class="planned">
      {planned.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <ul class="statuses">
      <li>
        <Status id="community-node-kit" showLabel />
      </li>
      <li>
        <Status id="one-click-install" showLabel />
      </li>
      <li>
        <Status id="compute-locality" showLabel />
      </li>
    </ul>
    <div class="ctas">
      <Button href={TALK_URL} variant="on-dark">
        Interested in hosting? Talk to us
      </Button>
      <Button href={REPO_URL} variant="on-dark">
        Follow along on GitHub
      </Button>
    </div>
  </Section>

  <CallToAction kicker="Get in touch" title="Could your community run a node?">
    <p>
      If you're part of a local library, co-op, club or any group that might host one, we'd love to
      hear from you. The first community nodes will be shaped by the first communities.
    </p>
    <Fragment slot="ctas">
      <Button href={TALK_URL}>Talk to us</Button>
      <Button href="/manifesto/" variant="secondary">
        Read the manifesto
      </Button>
    </Fragment>
  </CallToAction>
</Base>

<style>
  .hosts,
  .prec {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-5);
  }
  .hosts li,
  .prec li {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-3);
  }
  .locality {
    margin-top: var(--space-4);
  }
  .tiers {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    border-top: 2px solid var(--ink);
  }
  .tiers li {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .tiers h3,
  .tiers p {
    margin: 0 0 var(--space-1);
  }
  .num {
    flex: none;
    align-self: flex-start;
    background: var(--ink);
    color: var(--chalk);
    padding: 0.2rem 0.45rem;
  }
  .trade {
    font-size: 0.95rem;
    opacity: 0.85;
  }
  .costs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
  }
  .costs div {
    border-top: 2px solid var(--chalk);
    padding-top: var(--space-3);
  }
  .costs dt {
    color: var(--sun-light);
    margin-bottom: var(--space-2);
  }
  .costs dd {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .small {
    font-size: 0.95rem;
    opacity: 0.9;
    margin-top: var(--space-5);
  }
  .sub {
    margin-top: var(--space-6);
  }
  .planned {
    margin: 0 0 var(--space-5);
    padding-left: 1.2rem;
    line-height: 1.8;
  }
  .statuses {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0;
    display: grid;
    gap: var(--space-2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
