{
  "name": "freehold-earth-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4322",
    "astro": "astro",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:dist": "vitest run tests/dist.test.ts --passWithNoTests",
    "e2e": "playwright test",
    "emdash": "node scripts/check-emdash.mjs src public DESIGN.md .claude dist",
    "links": "linkinator dist --recurse --skip \"^https?://(?!localhost)\"",
    "check:sources": "node scripts/check-sources.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:dist && pnpm emdash && pnpm links && pnpm e2e",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.24.0"
}
